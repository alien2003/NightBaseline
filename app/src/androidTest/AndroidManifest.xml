<?xml version="1.0" encoding="utf-8"?>
<!--
    The manifest of the TEST APK only (io.github.alien2003.nightbaseline.test); it is never merged into the app, whose
    manifest stays read-only (MergedManifestTest).

    Two instrumentations:
    - E2eRunner (generated by AGP from testInstrumentationRunner) targets the installed app: those tests run in the
      app's process, as the app, with the app's READ permissions.
    - SelfE2eRunner (added to the merged test manifest by app/build.gradle.kts, E2eSelfInstrumentationTask: AGP folds
      every instrumentation declared here into the generated one) targets the test package itself: WriteDeleteE2e
      and WriteCleanupE2e run in the test package's own process with the test package's own permissions. A Health
      Connect permission is granted to the package that declares it, and the app declares no WRITE permission, so the
      single test write is made as the test package (its own data origin), never as the app.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The only write permission of the suite, for exactly one record type. Never granted at install (the runner
        installs without -g); the owner grants it explicitly with the runner's grant-write option, and it disappears
        with the test package when the runner uninstalls it. Without it WriteDeleteE2e is skipped.
    -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="NightBaseline E2E tests">

        <!-- What Health Connect shows for the test package's WRITE_STEPS permission. -->
        <activity
            android:name="io.github.alien2003.nightbaseline.e2e.support.E2eRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+: without this alias Health Connect does not grant health permissions. -->
        <activity-alias
            android:name="io.github.alien2003.nightbaseline.e2e.support.E2eViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity="io.github.alien2003.nightbaseline.e2e.support.E2eRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />

                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
