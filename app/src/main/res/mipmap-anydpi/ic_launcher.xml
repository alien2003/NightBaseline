<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon "aurora-range" (minSdk 28): midnight gradient background, a luminous aurora ribbon (the usual
     range) with three nights and a crescent, a separate monochrome silhouette for themed icons. Own art, no vendor art.
     Renders: IconRenderTest (app/build/icon-renders). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
