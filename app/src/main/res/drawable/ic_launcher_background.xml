<?xml version="1.0" encoding="utf-8"?>
<!-- 108 dp adaptive background "aurora-range": an airy midnight gradient lit from the top left, a faint aurora haze
     behind the ribbon, a teal afterglow at the bottom and a gentle vignette. Own art, no vendor resources. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Midnight base: luminous indigo at the top left, a calm blue night at the bottom right. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="16"
                android:startY="12"
                android:endX="92"
                android:endY="100">
                <item android:offset="0" android:color="#FF4D63C4" />
                <item android:offset="0.5" android:color="#FF2A3890" />
                <item android:offset="1" android:color="#FF17225E" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Aurora haze: a wide, very soft teal-blue glow along the ribbon's path. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="58"
                android:centerY="62"
                android:gradientRadius="42"
                android:startColor="#4D52C2E0"
                android:centerColor="#1E4A6BD8"
                android:endColor="#00000000" />
        </aapt:attr>
    </path>
    <!-- Teal afterglow rising from the bottom edge. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50"
                android:centerY="106"
                android:gradientRadius="40"
                android:startColor="#4048D8C8"
                android:endColor="#0048D8C8" />
        </aapt:attr>
    </path>
    <!-- Top-left light source: a soft, airy sheen. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="24"
                android:centerY="16"
                android:gradientRadius="54">
                <item android:offset="0" android:color="#66BCC8FF" />
                <item android:offset="0.45" android:color="#24A9B8FF" />
                <item android:offset="1" android:color="#00A9B8FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Gentle vignette: only the far corners settle into night. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50"
                android:centerY="48"
                android:gradientRadius="66">
                <item android:offset="0" android:color="#000A0E30" />
                <item android:offset="0.62" android:color="#000A0E30" />
                <item android:offset="1" android:color="#660A0E30" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
