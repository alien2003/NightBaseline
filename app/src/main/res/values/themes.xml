<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window theme only: everything inside is drawn by Compose (NightBaselineTheme). The window background is
      color.background so that the first frame and the edge-to-edge system bars match the content.
    -->
    <style name="Theme.NightBaseline" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nb_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
