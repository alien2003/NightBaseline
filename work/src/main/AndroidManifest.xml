<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The night notification. Requested at runtime on Android 13+; without it the daily run still evaluates and
        stores nights. No foreground service: the daily run reads in the background with
        READ_HEALTH_DATA_IN_BACKGROUND (declared by :app together with the other health permissions).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

</manifest>
